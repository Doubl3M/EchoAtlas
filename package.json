{
    "name": "echoatlas",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"benchmarks/**/*.{ts,mjs}\" \"*.{json,js,ts,html}\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"benchmarks/**/*.{ts,mjs}\" \"*.{json,js,ts,html}\"",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "node --test tests/e2e/first-navigable-map.test.mjs",
        "benchmark": "node --expose-gc benchmarks/run.mjs",
        "benchmark:world-scaling": "node benchmarks/world-scaling.mjs",
        "benchmark:hierarchical-repulsion": "node benchmarks/hierarchical-repulsion.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.32.0",
        "prettier": "^3.6.2",
        "puppeteer-core": "25.3.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.0",
        "vite": "^7.1.1",
        "vitest": "^3.2.4"
    }
}
